<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="payment_provider_form" model="ir.ui.view">
        <field name="name">NEGDI Provider Form</field>
        <field name="model">payment.provider</field>
        <field name="inherit_id" ref="payment.payment_provider_form"/>
        <field name="arch" type="xml">
            <group name="provider_credentials" position="inside">
                <group invisible="code != 'negdi'">
                    <field name="negdi_terminal_id" string="Terminal ID"
                           required="code == 'negdi' and state != 'disabled'"/>
                    <field name="negdi_username" string="Username"
                           required="code == 'negdi' and state != 'disabled'"/>
                    <field name="negdi_password" string="Password" password="True"
                           required="code == 'negdi' and state != 'disabled'"/>
                    <field name="negdi_api_url" string="API URL"
                           required="code == 'negdi' and state != 'disabled'"/>
                    <field name="negdi_public_key" string="Public Key"
                           required="code == 'negdi' and state != 'disabled'"/>
                    <field name="negdi_insecure_url" invisible="1"/>
                    <div class="alert alert-warning mb-0" role="alert" colspan="2"
                         invisible="not negdi_insecure_url">
                        This gateway address is plain HTTP, so the username and password
                        travel unencrypted with every request. Ask NEGDI for an HTTPS address.
                    </div>
                    <button string="Test connection" type="object" colspan="2"
                            name="action_negdi_test_connection" class="btn-secondary"/>
                </group>
            </group>
        </field>
    </record>
</odoo>
