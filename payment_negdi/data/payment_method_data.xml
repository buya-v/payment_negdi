<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="payment_method_qpay" model="payment.method">
        <field name="name">QPay</field>
        <field name="code">qpay</field>
        <field name="sequence">20</field>
        <field name="active">False</field>
        <field name="image" type="base64" file="payment_negdi/static/img/qpay.png"/>
        <field name="support_tokenization">False</field>
        <field name="support_express_checkout">False</field>
        <field name="support_refund">full_only</field>
        <field name="supported_country_ids" eval="[Command.set([ref('base.mn')])]"/>
        <field name="supported_currency_ids" eval="[Command.set([ref('base.MNT')])]"/>
    </record>
</odoo>
